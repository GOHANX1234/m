<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground + splash-screen icon.

    Viewport: 108 × 108 dp (standard adaptive-icon foreground size).
    Safe zone: 66 dp circle centred at (54, 54) — radius 33 dp.
               Anything outside this circle may be clipped by the launcher mask.

    ALL letter paths are scaled ~65 % and re-centred so the rightmost point of
    the "A" sits at x ≈ 82, well inside the safe-zone circle.
-->
